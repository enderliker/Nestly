# Bot token. Required. Never commit a real value.
DISCORD_TOKEN=

# Optional per-module overrides. Each module otherwise uses DISCORD_TOKEN.
# DISCORD_TOKEN_MUSIC=
# DISCORD_TOKEN_OPS=

# Optional dedicated token for supervisor alerts (NESTLY_OPS_TOKEN or legacy RSBOT_OPS_TOKEN).
NESTLY_OPS_TOKEN=

# Alert channel override; the configuration file may set notifications.channel_id.
NESTLY_ALERT_CHANNEL=

# Launcher settings (defaults target a Pterodactyl-style container).
# NESTLY_REPO=enderliker/nestly
# NESTLY_RELEASE=latest
# NESTLY_INSTALL_DIR=/home/container/nestlybins
# NESTLY_STATE_DIR=/home/container/nestly-state
# NESTLY_CONFIG=/home/container/nestly.toml
# NESTLY_PUBKEY=
# NESTLY_GITHUB_TOKEN=
# NESTLY_SKIP_UPDATE=0
# NESTLY_RESTART_BUDGET=3