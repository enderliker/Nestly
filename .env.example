# Bot token. Required. Never commit a real value.
DISCORD_TOKEN=

# Optional per-module overrides. Each module otherwise uses DISCORD_TOKEN.
# DISCORD_TOKEN_MUSIC=
# DISCORD_TOKEN_OPS=

# Optional dedicated token for supervisor alerts.
RSBOT_OPS_TOKEN=

# Alert channel override; the configuration file may set notifications.channel_id.
RSBOT_ALERT_CHANNEL=

# Launcher settings (defaults target a Pterodactyl-style container).
# RSBOT_REPO=enderliker/rsbot
# RSBOT_RELEASE=latest
# RSBOT_INSTALL_DIR=/home/container/rsbotbins
# RSBOT_STATE_DIR=/home/container/rsbot-state
# RSBOT_CONFIG=/home/container/rsbot.toml
# RSBOT_PUBKEY=
# RSBOT_GITHUB_TOKEN=
# RSBOT_SKIP_UPDATE=0
# RSBOT_RESTART_BUDGET=3